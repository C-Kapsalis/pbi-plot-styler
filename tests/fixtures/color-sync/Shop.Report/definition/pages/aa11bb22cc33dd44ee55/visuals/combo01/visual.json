{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "combo01",
  "position": {
    "x": 0,
    "y": 0,
    "z": 0,
    "width": 200,
    "height": 100
  },
  "visual": {
    "visualType": "lineStackedColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendar"
                    }
                  },
                  "Property": "Month"
                }
              }
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Sales Measures"
                    }
                  },
                  "Property": "Revenue"
                }
              },
              "queryRef": "Sales Measures.Revenue"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Sales Measures"
                    }
                  },
                  "Property": "Basket Size"
                }
              },
              "queryRef": "Sales Measures.Basket Size"
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#abcdef'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "metadata": "Sales Measures.Basket Size"
          }
        }
      ]
    }
  }
}
