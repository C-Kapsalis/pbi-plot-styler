{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "combo_main",
  "position": {
    "x": 300,
    "y": 700,
    "z": 1,
    "width": 200,
    "height": 60
  },
  "visual": {
    "visualType": "lineStackedColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Ad Spend"
                    }
                  },
                  "Property": "Channel"
                }
              },
              "queryRef": "Ad Spend.Channel"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "#Report Measures"
                    }
                  },
                  "Property": "Clicks"
                }
              },
              "queryRef": "#Report Measures.Clicks",
              "nativeQueryRef": "Clicks"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "#Report Measures"
                    }
                  },
                  "Property": "!Cost"
                }
              },
              "queryRef": "#Report Measures.!Cost",
              "nativeQueryRef": "!Cost"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "#Report Measures"
                    }
                  },
                  "Property": "z_space"
                }
              },
              "queryRef": "#Report Measures.z_space"
            }
          ],
          "fieldParameters": [
            {
              "parameterExpr": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "y-Plot Specific 1"
                    }
                  },
                  "Property": "y-Plot Specific 1 Fields"
                }
              },
              "index": 0,
              "length": 1
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "ThemeDataColor": {
                      "ColorId": 2,
                      "Percent": 0
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
